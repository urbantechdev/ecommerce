rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isValidAdminId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.\\@]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Administrator & Whitelist Helpers ---
    function isRootAdmin() {
      return isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == 'moraasdorcah@gmail.com';
    }

    function isWhitelistedAdmin() {
      return isSignedIn() && (
        isRootAdmin() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower())))
      );
    }

    function isAdmin() {
      return isWhitelistedAdmin() || (
        isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN'
        )
      );
    }

    // --- User Schema Validation (Anti-Update-Gap) ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role', 'branchId', 'status', 'createdAt']) &&
             data.keys().hasOnly(['id', 'name', 'email', 'role', 'branchId', 'status', 'createdAt', 'pin', 'phone', 'lastLogin']) &&
             data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 255 &&
             data.role in ['SUPER_ADMIN', 'ADMIN', 'BRANCH_MANAGER', 'ACCOUNTANT', 'STORE_KEEPER', 'CASHIER', 'TAILOR', 'STAFF'] &&
             data.branchId is string && data.branchId.size() <= 64 &&
             data.status in ['ACTIVE', 'INACTIVE'] &&
             data.createdAt is string && data.createdAt.size() <= 64 &&
             (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
             (!('pin' in data) || (data.pin is string && data.pin.size() <= 16)) &&
             (!('lastLogin' in data) || (data.lastLogin is string && data.lastLogin.size() <= 64));
    }

    // --- Admin Whitelist Schema Validation ---
    function isValidAdmin(data) {
      return data.keys().hasAll(['email', 'role', 'status']) &&
             data.keys().hasOnly(['id', 'email', 'uid', 'name', 'role', 'status', 'addedBy', 'createdAt', 'updatedAt']) &&
             data.email is string && data.email.size() <= 255 &&
             data.role in ['ADMIN', 'SUPER_ADMIN'] &&
             data.status in ['ACTIVE', 'INACTIVE'] &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('uid' in data) || (data.uid is string && data.uid.size() <= 128)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 200)) &&
             (!('addedBy' in data) || (data.addedBy is string && data.addedBy.size() <= 200)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // --- Default Deny ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Users Collection (Hardened RBAC & PII Isolation) ---
    match /users/{userId} {
      // PII Isolation: Only user themselves or an admin can read the profile
      allow get: if isSignedIn() && (isOwner(userId) || isAdmin());
      
      // Allow listing only if admin (Query Enforcer)
      allow list: if isAdmin();
      
      // Allow creation: Admins can create any role; regular users can create their own profile only as STAFF
      allow create: if isSignedIn() && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (isOwner(userId) && incoming().role == 'STAFF')
      );
      
      // Allow updates for owner (profile info only, immutable role) or admin (roles/status)
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidUser(incoming()) && (
        isAdmin() || (
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'pin', 'lastLogin']) &&
          incoming().role == existing().role
        )
      );
      
      // Root primary admin can never be deleted from users
      allow delete: if isAdmin() && isValidId(userId) && userId != 'usr-admin-moraasdorcah';
    }

    // --- Dynamic Admins Whitelist Collection ---
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidAdminId(adminId);
      allow list: if isAdmin();
      
      // Creation: Root admin, existing admins, or root admin self-bootstrapping
      allow create: if isSignedIn() && isValidAdminId(adminId) && isValidAdmin(incoming()) && (
        isRootAdmin() ||
        isAdmin() ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'moraasdorcah@gmail.com')
      );
      
      // Update: Root admin or system administrator
      allow update: if isSignedIn() && isValidAdminId(adminId) && isValidAdmin(incoming()) && (
        isRootAdmin() || isAdmin()
      );
      
      // Delete: Admins can remove whitelist entries, but the root admin cannot be deleted
      allow delete: if isAdmin() && isValidAdminId(adminId) && adminId.lower() != 'moraasdorcah@gmail.com';
    }

    // --- Products Collection ---
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
