rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return isSignedIn() && request.auth.token.get('email_verified', false) == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'naisiaetext@gmail.com' ||
        request.auth.token.email == 'support@naisiaetextiles.com' ||
        (emailVerified() && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)))
      );
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /promotions/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
