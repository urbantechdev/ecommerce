{
  "entities": {
    "user": {
      "title": "User",
      "description": "Enterprise staff and management profile with RBAC permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": {
          "type": "string",
          "enum": [
            "SUPER_ADMIN",
            "ADMIN",
            "BRANCH_MANAGER",
            "ACCOUNTANT",
            "STORE_KEEPER",
            "CASHIER",
            "TAILOR",
            "STAFF"
          ]
        },
        "branchId": { "type": "string" },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" },
        "phone": { "type": "string" },
        "pin": { "type": "string", "pattern": "^\\d{4,6}$" }
      },
      "required": ["id", "name", "email", "role", "branchId", "status", "createdAt"]
    },
    "admin": {
      "title": "Admin",
      "description": "Dynamic administrator whitelist entry for privilege authorization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "SUPER_ADMIN"] },
        "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] },
        "addedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "user" },
      "description": "Central user storage for authentication and RBAC"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "admin" },
      "description": "Administrator whitelist for dynamic runtime authorization"
    }
  }
}
